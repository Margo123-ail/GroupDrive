PORT=3000
NODE_ENV=development
# После публикации замени localhost на публичный адрес сайта, иначе ссылки в письмах не откроются у других пользователей.
APP_URL=http://localhost:3000
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
MAX_FILE_MB=500

# Администратор создаётся при первом запуске. Если эта почта уже есть в базе, её аккаунт получит роль admin.
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# Реальная отправка писем через Brevo API (рекомендуется). Личный пароль от почты НЕ нужен.
# Создай API key в Brevo и добавь подтверждённый email отправителя.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=GroupDrive

# Необязательный SMTP-резервный вариант; обычно Brevo API выше проще и не требует почтового пароля.
# MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
